{
  "name": "preside-tiptap",
  "version": "0.0.1",
  "private": true,
  "description": "Build tooling for the Preside Tiptap rich-editor external. Bundles Tiptap v3 into self-contained IIFEs served by Preside's Sticker.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-subscript": "^3.28.0",
    "@tiptap/extension-superscript": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-table-cell": "^3.28.0",
    "@tiptap/extension-table-header": "^3.28.0",
    "@tiptap/extension-table-row": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
